# Banco de dados PostgreSQL (a hospedagem geralmente fornece essa URL pronta)
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# Porta que o servidor vai rodar
PORT=3000

# Chave secreta para sessão de login (troque por qualquer texto aleatorio longo)
SESSION_SECRET=troque_isso_por_um_texto_aleatorio_bem_grande

# Login do painel (o unico usuario que vai acessar o sistema, ou seja, voce)
ADMIN_EMAIL=seuemail@exemplo.com
ADMIN_PASSWORD=escolha_uma_senha_forte

# Os secrets dos webhooks (DataCrazy, Payt, Skale) NAO ficam mais aqui --
# eles sao gerados automaticamente no primeiro start e ficam no banco de dados,
# editaveis direto pela tela Configuracoes > Webhooks do painel (sem precisar
# mexer na hospedagem ou reiniciar o servidor).

# Janela de tempo (em horas) para considerar que uma venda veio de um lead
# especifico. Ex: 72 = casa a venda com o ultimo lead daquele telefone
# recebido nas ultimas 72 horas.
JANELA_ATRIBUICAO_HORAS=72
